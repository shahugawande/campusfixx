PORT=3000
# Where your frontend runs (comma separated). Use * only for testing.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5500,http://127.0.0.1:5500
# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
# Admins need this code to create their own account (share it only with staff)
ADMIN_INVITE_CODE=CHANGE-THIS-STAFF-CODE
# Optional: auto-creates the first admin if none exists
ADMIN_USER=admin
ADMIN_PASS=ChangeMe@123
